### FUNCTIONS

mkcd () {
    mkdir -p -- "$1" && cd -- "$1"
}

# edit all files matching an ag query
vimag () {
    if [[ $# -le 0  ]]
    then
        echo "ERROR: You must provide a search parameter." 1>&2
        return
    fi

    vim `ag -l $1`
}

# optimize a video file
ffmpeg-optimize() {
  ffmpeg -i "$1" -c:v libx264 -crf 23 -preset medium -c:a aac -b:a 128k "$2"
}
